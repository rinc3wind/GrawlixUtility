<Window x:Class="GrawlixUtility.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grawlix Utility" Width="860" Height="650" MinWidth="700" MinHeight="540"
        Background="{StaticResource Canvas}" Foreground="{StaticResource TextMain}"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
  <Window.Resources>
    <Style x:Key="AppListItemStyle" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,2"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource PanelRaised}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#28364A"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <TabControl Margin="30" SelectedIndex="0">
    <TabItem Header="Layouts">
      <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="*"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="PROFILE" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0" />
        <ComboBox x:Name="ProfileCombo" Grid.Column="1" SelectionChanged="ProfileCombo_SelectionChanged">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{StaticResource TextMain}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="3" Content="＋ New profile" Click="NewProfile_Click" Margin="0,0,8,0" />
        <Button Grid.Column="4" Content="Rename" Click="RenameProfile_Click" Margin="0,0,8,0" />
        <Button Grid.Column="5" Content="Delete profile" Click="DeleteProfile_Click" Margin="0,0,8,0" />
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Applications" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Drop an app or shortcut here, or add it from disk." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
        <Button Grid.Column="1" Content="＋ Add executable" Click="AddExecutable_Click" VerticalAlignment="Center" />
      </Grid>
      <Border Grid.Column="0" Grid.Row="2" x:Name="DropZone" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="8">
        <Grid><ListBox x:Name="ApplicationsList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}" ItemsSource="{Binding Applications}" ItemContainerStyle="{StaticResource AppListItemStyle}" AllowDrop="True" DragOver="List_DragOver" Drop="List_Drop">
          <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="8" Background="#29364A" VerticalAlignment="Center" Padding="3"><Grid><TextBlock Text="▣" Foreground="{StaticResource Accent}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant" /></Grid></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Path}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Run" Padding="12,6" Margin="0,0,8,0" Click="RunExecutable_Click" Tag="{Binding}" />
              <Button Content="Remove" Padding="10,6" Click="RemoveExecutable_Click" Tag="{Binding}" />
            </StackPanel>
          </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
          <StackPanel x:Name="EmptyHint" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="＋" Foreground="{StaticResource Accent}" FontSize="26" HorizontalAlignment="Center"/><TextBlock Text="Drop executable files to add them" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,8,0,0"/></StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="4" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/></StackPanel>
      <Button Grid.Column="1" Content="Save current layout" Click="SaveLayout_Click" />
    </Grid>
    <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <CheckBox x:Name="CloseAllCheckBox" Content="Close all" VerticalAlignment="Center" />
      <Button Grid.Column="2" Content="Restore layout" Background="#3977D5" BorderBrush="#3977D5" FontSize="14" Padding="16,12" Click="RestoreLayout_Click" />
    </Grid>
      </Grid>
    </TabItem>
    <TabItem Header="Web2App">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="*"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="16">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="CHROME" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock x:Name="ChromePathText" Grid.Column="1" Text="No Chrome executable selected" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" />
            <Button Grid.Column="2" Content="Select Chrome…" Click="SelectChrome_Click" />
          </Grid>
        </Border>
        <Grid Grid.Row="2">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Webpages" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Add a webpage link or drop a URL shortcut here, then click Run to open it in a detached Chrome window." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="WebLinkInput" VerticalContentAlignment="Center" KeyDown="WebLinkInput_KeyDown" ToolTip="Enter a webpage URL (e.g. https://example.com)" />
            <Button Grid.Column="2" Content="＋ Add link" Click="AddWebLink_Click" />
          </Grid>
          <Border Grid.Row="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="8">
            <Grid><ListBox x:Name="WebAppsList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}" ItemContainerStyle="{StaticResource AppListItemStyle}" AllowDrop="True" DragOver="WebAppsList_DragOver" Drop="WebAppsList_Drop">
              <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="8" Background="#29364A" VerticalAlignment="Center" Padding="3"><Grid><TextBlock Text="↗" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"/></Grid></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Url}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Run" Padding="12,6" Margin="0,0,8,0" Click="RunWebLink_Click" Tag="{Binding}" />
                  <Button Content="Remove" Padding="10,6" Click="RemoveWebLink_Click" Tag="{Binding}" />
                </StackPanel>
              </Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
              <StackPanel x:Name="WebEmptyHint" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="＋" Foreground="{StaticResource Accent}" FontSize="26" HorizontalAlignment="Center"/><TextBlock Text="Add webpage links to launch them in Chrome" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,8,0,0"/></StackPanel>
            </Grid>
          </Border>
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,8,0"/><TextBlock x:Name="WebStatusText" Text="Ready" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/></StackPanel>
      </Grid>
    </TabItem>
    <TabItem Header="Microphone">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="*"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="18">
          <StackPanel>
            <TextBlock Text="MICROPHONE TOGGLE" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="Mute your microphone with Scroll Lock" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" />
            <TextBlock Text="MicToggle controls the Windows default and communications microphones together. The Scroll Lock LED indicates when the microphone is active." Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="18">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Ellipse x:Name="MicStatusDot" Width="12" Height="12" Fill="{StaticResource TextMuted}" HorizontalAlignment="Center" />
            <TextBlock x:Name="MicStatusText" Text="Checking MicToggle status…" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
            <TextBlock Text="When running, MicToggle stays in the system tray and keeps the global key hook active." Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400" Margin="0,6,0,18" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button x:Name="StartMicToggleButton" Content="Start MicToggle" Click="StartMicToggle_Click" Margin="0,0,8,0" />
              <Button x:Name="StopMicToggleButton" Content="Exit MicToggle" Click="StopMicToggle_Click" Margin="0,0,8,0" />
              <Button Content="Sound settings" Click="OpenSoundSettings_Click" />
            </StackPanel>
          </StackPanel>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,8,0"/><TextBlock x:Name="MicStatusDetailText" Text="MicToggle is included with this app." Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/></StackPanel>
      </Grid>
    </TabItem>
    <TabItem ToolTip="Settings" AutomationProperties.Name="Settings">
      <TabItem.Header><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" /></TabItem.Header>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Choose what starts when you sign in to Windows." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="18" VerticalAlignment="Top">
          <StackPanel>
            <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start automatically on Windows boot" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed" />
            <TextBlock Text="Grawlix Utility will open when you sign in to Windows." Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="24,6,0,12" />
            <CheckBox x:Name="StartMicrophoneToggleCheckBox" Content="Start Microphone Toggle automatically" Checked="StartMicrophoneToggle_Changed" Unchecked="StartMicrophoneToggle_Changed" />
            <TextBlock Text="When enabled, MicToggle starts whenever Grawlix Utility opens." Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="24,6,0,0" />
            <TextBlock x:Name="StartupSettingsStatus" Text="" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="24,10,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </TabItem>
  </TabControl>
</Window>
