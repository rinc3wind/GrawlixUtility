<Window x:Class="PersistentWindows.DeleteProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete profile" Width="390" Height="205" MinWidth="390" MinHeight="205" MaxWidth="390" MaxHeight="205"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Canvas}" Foreground="{StaticResource TextMain}">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Delete profile?" FontSize="16" FontWeight="SemiBold" />
    <TextBlock x:Name="PromptText" Grid.Row="1" Foreground="{StaticResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,14" VerticalAlignment="Top" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" IsDefault="True" MinWidth="84" Margin="0,0,8,0" />
      <Button Content="Delete profile" MinWidth="112" Background="#A94444" BorderBrush="#A94444" Click="Delete_Click" />
    </StackPanel>
  </Grid>
</Window>